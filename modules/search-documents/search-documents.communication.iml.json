{
    "url": "/api/public-api/docs/search",
    "method": "POST",
    "body": {
        "query": "{{parameters.query}}",
        "searchOnlyTitle": "{{parameters.searchOnlyTitle}}",
        "type": "{{parameters.type}}",
        "parentDocId": "{{parameters.parentDocId}}"
    },
    "response": {
        "iterate": "{{body.docs}}",
        "output": "{{item}}",
        "limit": "{{parameters.limit}}"
    }
}