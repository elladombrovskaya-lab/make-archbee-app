{
  "url": "/api/public-api/docs/search",
  "method": "POST",
  "headers": {
    "Authorization": "Bearer {{base64(parameters.docSpaceId + '~' + parameters.apiKey)}}",
    "Content-Type": "application/json"
  },
  "body": {
    "query": ""
  },
  "response": {
    "valid": "{{statusCode == 200}}",
    "error": {
      "message": "[{{statusCode}}] {{if(length(body.messages) > 0, join(body.messages, ', '), 'Connection failed. Check your Doc Space ID and API Key.')}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
