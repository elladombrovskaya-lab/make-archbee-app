{
  "url": "/api/public-api/import-content",
  "method": "POST",
  "type": "multipart/form-data",
  "body": {
    "file": {
      "value": "{{parameters.data}}",
      "options": {
        "filename": "{{parameters.fileName}}"
      }
    },
    "type": "{{parameters.type}}"
  },
  "response": {
    "output": "{{body.data}}"
  }
}
